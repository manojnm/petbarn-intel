# Copy to .streamlit/secrets.toml for LOCAL testing of the Cloud secrets path only.
# On Streamlit Community Cloud, paste these into the app's Settings -> Secrets box
# instead -- never commit a real secrets.toml (it's already in .gitignore).
#
# Deliberately OpenAI here, not Azure: Azure OpenAI is used for local dev only and
# its credentials never leave the developer's machine. The deployed/public app
# runs on a separate OpenAI key with its own (small) budget -- see README "Deployment".
LLM_PROVIDER = "openai"
OPENAI_API_KEY = "sk-..."
OPENAI_CHAT_MODEL_MINI = "gpt-4o-mini"
OPENAI_CHAT_MODEL_MAIN = "gpt-4o-mini"
OPENAI_EMBEDDING_MODEL = "text-embedding-3-small"
